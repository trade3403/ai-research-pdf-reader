{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Research PDF Reader",
  "version": "0.5.9",
  "identifier": "app.researchstudio.pdfreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Research Scientist Studio — PDF, ChatGPT & Word",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f5f6f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' http://127.0.0.1:5173 https://api.crossref.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
