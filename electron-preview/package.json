{
  "name": "research-studio-electron-preview",
  "version": "0.6.1",
  "private": true,
  "description": "Desktop migration preview; not feature complete",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "workspace": "node scripts/copy-workspace.cjs",
    "test:gui": "node scripts/gui-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.11.5",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "app.researchstudio.electron.preview",
    "productName": "Research Studio Preview",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "policy.cjs",
      "index.html",
      "renderer.js",
      "style.css",
      "workspace/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
